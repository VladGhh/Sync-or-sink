  - component: {fileID: 1617570748}
  - component: {fileID: 1617570747}
  - component: {fileID: 1617570746}
  m_Layer: 3
  m_Name: IntroManager
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1617570746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1617570745}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 03945e8ca9233f247b4c34a6eb7df4ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialIntroManager
  lines:
  - subtitleText: Oh, what have we got here? Who are you, little ones?
    voiceClip: {fileID: 8300000, guid: 0b0d8bf188ba8b145acafe0a89b5826b, type: 3}
    rightHandSprite: {fileID: 849259268559456503, guid: 42ff8fd7c4b4b264a99b6e9f20bec7bb, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: You don't know, right? That's alright, I don't either.
    voiceClip: {fileID: 8300000, guid: e2852f4fd0ad76b41a8d94cbdedcef50, type: 3}
    rightHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: "No, wait\u2014I know, actually. I am the narrator, and this is
      my game."
    voiceClip: {fileID: 8300000, guid: 33d2267898a434741b9bfe39603d4cc2, type: 3}
    rightHandSprite: {fileID: -2569638972143075865, guid: dad35966d62847a4699cc64688cc06a7, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: Already trying to leave? Isn't it weird? Where are you going? How
      do you know it's better out of my hand? Is my voice so annoying that you would
      risk falling endlessly into the void? Rude.
    voiceClip: {fileID: 8300000, guid: 27886279239aef84abec6156179d2c5f, type: 3}
    rightHandSprite: {fileID: -1492885393255162659, guid: 51437563832f8ec4a8ead8197865b408, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: No, it's not my voice, is it? There's something weird in all beings,
      isn't there?
    voiceClip: {fileID: 8300000, guid: e54725b73b08bc748ac9c05374150784, type: 3}
    rightHandSprite: {fileID: 849259268559456503, guid: 42ff8fd7c4b4b264a99b6e9f20bec7bb, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: "Before you even know who you are, you want to be free\u2014before
      even knowing what 'free' means. Isn't that crazy?"
    voiceClip: {fileID: 8300000, guid: 5184fe8842f31ce41bb9d96df67c6db1, type: 3}
    rightHandSprite: {fileID: -2569638972143075865, guid: dad35966d62847a4699cc64688cc06a7, type: 3}
    leftHandSprite: {fileID: 943917589616848146, guid: 6948784025e169f418ab9e637ef077b9, type: 3}
    fallbackDuration: 2
  - subtitleText: Don't worry, I won't throw you into the void. I'll help you on
      your little adventure. It's been some time since I had someone to talk to.
    voiceClip: {fileID: 8300000, guid: 9925d92e9494b5e44a6a912ec0b269ef, type: 3}
